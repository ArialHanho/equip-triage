{
  "data": "synthetic, hand-authored; not actual line data",
  "environment": {
    "python": "3.12.14",
    "sklearn": "1.8.0",
    "numpy": "2.3.5"
  },
  "splits": {
    "train": {
      "rows": 24,
      "groups": [
        "actuator",
        "contact",
        "environment",
        "link",
        "recipe",
        "repeat",
        "threshold",
        "time"
      ]
    },
    "validation": {
      "rows": 12,
